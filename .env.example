# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
TENANT_ENFORCEMENT=strict

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=safefood_user
POSTGRES_PASSWORD=safefood_pass_2026
POSTGRES_DB=safefood_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://safefood_user:safefood_pass_2026@localhost:5432/safefood_db
# For async connections:
ASYNC_DATABASE_URL=postgresql+psycopg://safefood_user:safefood_pass_2026@localhost:5432/safefood_db

# Cache & Message Broker (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local or AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
AWS_REGION=ap-south-1
S3_BUCKET_NAME=safefood-documents

# Search Engine (OpenSearch 2)
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=safefood_

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ENFORCED=false

# AI & Embedding Gateway (mock, openai, anthropic, gemini)
LLM_PROVIDER=mock
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
AI_CONFIDENCE_THRESHOLD=0.85
